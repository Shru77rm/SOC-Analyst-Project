# ---------- Copy to .env and edit. NEVER commit .env ----------

# ---- App ----
APP_ENV=development                # development | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Auth (JWT) ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
# Seed accounts, created on first start if they do not exist (passwords are stored bcrypt-hashed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ANALYST_USERNAME=analyst
SEED_ANALYST_PASSWORD=
# Shared key Logstash sends in the X-Ingest-Key header to POST /api/logs/ingest
INGEST_API_KEY=

# ---- MongoDB (incidents, alerts, users, model metadata) ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB=soc_analyst

# ---- Elasticsearch (searchable security events) ----
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=soc-events

# ---- Resilience ----
# If MongoDB is unreachable at startup, fall back to a NON-PERSISTENT in-memory store (health shows "degraded")
ALLOW_MEMORY_FALLBACK=true

# ---- Machine learning ----
MODEL_DIR=../ml/models

# ---- AI summary service ----
# template  = deterministic, evidence-only summaries (no external calls)
# anthropic = LLM summaries (needs ANTHROPIC_API_KEY); falls back to template on any failure
AI_SUMMARY_PROVIDER=template
ANTHROPIC_API_KEY=
AI_SUMMARY_MODEL=claude-opus-5     # any Claude model ID; pick a cheaper one if cost matters

# ---- Demo mode ----
DEMO_MODE_ENABLED=true

# ---- Logstash consumer (analyses events that Logstash indexed into Elasticsearch, soc_status=pending) ----
# See elk/README.md. Only active when Elasticsearch is configured.
LOGSTASH_CONSUMER_ENABLED=true
LOGSTASH_CONSUMER_INTERVAL_SECONDS=2
LOGSTASH_CONSUMER_BATCH=200

# =====================================================================================================================
# DOCKER COMPOSE  (docker compose up -d --build).  Generate real values with:  python scripts/docker/init_env.py
# Compose reads this file for variable substitution. Inside the containers the data-store URLs are set by
# docker-compose.yml (mongodb / elasticsearch service names), so MONGO_URI and ELASTICSEARCH_URL above are NOT used there.
# REQUIRED (compose refuses to start without them): JWT_SECRET, SEED_ADMIN_PASSWORD, SEED_ANALYST_PASSWORD, MONGO_ROOT_PASSWORD
# =====================================================================================================================
MONGO_ROOT_USER=soc
MONGO_ROOT_PASSWORD=                 # letters+digits only (it is embedded in a connection URI). Applied on FIRST start of the volume.
UI_PORT=8080                         # the only port published to the network
ES_INDEX_PREFIX=soc-events           # feeds BOTH Logstash and the backend (ELASTICSEARCH_INDEX_PREFIX)
ES_HEAP=512m                         # Elasticsearch JVM heap
LOGSTASH_HEAP=512m
LOGSTASH_TCP_PORT=5000               # bound to 127.0.0.1 only
LOGSTASH_BEATS_PORT=5044             # bound to 127.0.0.1 only
KIBANA_PORT=5601                     # with: docker compose --profile kibana up -d
# SAMPLE_LOGS_DIR=./elk/no-samples   # start WITHOUT the synthetic sample logs (default: ./sample_logs)
# debug overlay (docker-compose.debug.yml): API_PORT=8000  ES_PORT=9200  MONGO_PORT=27017   (127.0.0.1 only)
