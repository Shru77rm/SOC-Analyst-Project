# Build context for the BACKEND image is the repository root. Allow-list style: only what the image needs.
*
!backend/
!ml/

# ...and even inside those, never ship:
**/__pycache__
**/*.pyc
**/.pytest_cache
backend/tests
backend/requirements.lock.txt
ml/models/*
!ml/models/.gitkeep
ml/data
ml/notebooks
**/.env
**/.env.*
